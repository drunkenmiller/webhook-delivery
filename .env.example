# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker compose)
POSTGRES_USER=webhooks
POSTGRES_PASSWORD=webhooks
POSTGRES_DB=webhooks
POSTGRES_PORT=5432

# Used by dbmate, the API and the worker
DATABASE_URL=postgres://webhooks:webhooks@localhost:5432/webhooks?sslmode=disable

# API
PORT=3000
# Admin routes (POST /v1/applications). At least 16 characters; generate with: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token-change-me
LOG_LEVEL=info
# Allow endpoint URLs on private/loopback addresses (SSRF guard), in the API and the worker.
# The API defaults to true outside production; the worker always defaults to false. Never true in production.
ALLOW_PRIVATE_TARGETS=true
# Browser origins allowed to call the API (comma-separated). The dashboard's dev server:
CORS_ORIGINS=http://localhost:5173

# Worker (Go). Every setting and its default: SPEC §7. Durations use Go syntax: 500ms, 30s, 1h.
# WORKER_ID=            # default: hostname-pid
# CONCURRENCY=8
# POLL_INTERVAL=500ms
# LEASE_DURATION=30s    # must be >= REQUEST_TIMEOUT + 5s
# REQUEST_TIMEOUT=10s
# MAX_ATTEMPTS=8
# BACKOFF_BASE=5s
# BACKOFF_CAP=1h
# SHUTDOWN_GRACE=25s

# Containers started with `make up` (docker compose --profile app)
API_PORT=3000
RECEIVER_PORT=4000
RECEIVER_WEBHOOK_SECRET=
