{
  "name": "@webhook-delivery/receiver",
  "version": "0.1.0",
  "private": true,
  "description": "Test receiver: verifies Standard Webhooks signatures and simulates failing or slow endpoints",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "standardwebhooks": "^1.1.1"
  }
}
